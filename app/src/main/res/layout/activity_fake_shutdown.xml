<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- Blackout Overlay (Covering entire screen) -->
    <View
        android:id="@+id/viewBlackout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true" />

    <!-- Simulated Authentic Android Power Off Dialog (Visible for first 2 seconds) -->
    <LinearLayout
        android:id="@+id/layoutShutdownDialog"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/ic_launcher_background"
        android:backgroundTint="#1F2937"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center"
        android:elevation="10dp">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminate="true"
            android:indeterminateTint="#38BDF8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="Power off"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="Shutting down..."
            android:textColor="#9CA3AF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Hidden Emergency Wake Zone (Top Right corner) -->
    <View
        android:id="@+id/viewSecretWakeTap"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="top|end"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true" />

</FrameLayout>
