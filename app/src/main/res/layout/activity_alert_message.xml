<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17"
    android:padding="20dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/llHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_marginTop="20dp">

                <ImageView
                    android:id="@+id/ivAlertIcon"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:contentDescription="Security Alert"
                    android:src="@drawable/app_logo" />

                <TextView
                    android:id="@+id/tvAlertTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.08"
                    android:text="URGENT OWNER ALERT"
                    android:textColor="#FF3B30"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvAlertSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="PASA Protected Device — Lost Mode Active"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Message Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#131B2E"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeColor="#FF3B30"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Message from owner:"
                        android:textColor="#38BDF8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvMessageContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Please return this device. Call 017xxxxxxxx for a reward." />

                    <TextView
                        android:id="@+id/tvTimestamp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:fontFamily="monospace"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        tools:text="Received: 14:15" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCallOwner"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="#22C55E"
                        android:fontFamily="sans-serif-black"
                        android:text="📞 Call Owner"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:visibility="gone"
                        app:cornerRadius="12dp"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PIN Lock Section -->
            <LinearLayout
                android:id="@+id/llPinSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvPinPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Enter Unlock PIN"
                    android:textColor="#E2E8F0"
                    android:textSize="15sp" />

                <!-- PIN Dots Display -->
                <TextView
                    android:id="@+id/tvPinDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.4"
                    android:text="• • • •"
                    android:textColor="#38BDF8"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <!-- Error feedback -->
                <TextView
                    android:id="@+id/tvPinError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FF3B30"
                    android:textSize="12sp"
                    android:visibility="invisible"
                    tools:text="Incorrect PIN (Attempt 1/3)" />

                <!-- Keypad Grid -->
                <GridLayout
                    android:id="@+id/glKeypad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="4"
                    android:alignmentMode="alignMargins"
                    android:layout_marginTop="8dp"
                    android:useDefaultMargins="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKey1"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:text="1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1E293B"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKey2"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:text="2"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1E293B"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKey3"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:text="3"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1E293B"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKey4"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:text="4"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1E293B"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKey5"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:text="5"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1E293B"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKey6"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:text="6"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1E293B"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKey7"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:text="7"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1E293B"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKey8"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:text="8"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1E293B"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKey9"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:text="9"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1E293B"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKeyDelete"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:text="⌫"
                        android:textSize="20sp"
                        android:textColor="#94A3B8"
                        android:backgroundTint="#0F172A"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKey0"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:text="0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#1E293B"
                        app:strokeColor="#334155"
                        app:strokeWidth="1dp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnKeyUnlock"
                        android:layout_width="80dp"
                        android:layout_height="60dp"
                        android:backgroundTint="#0284C7"
                        android:text="🔓"
                        android:textSize="20sp"
                        app:cornerRadius="16dp" />
                </GridLayout>
            </LinearLayout>

            <!-- Dismiss Button (Only active when PIN is NOT enforced) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDismiss"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif-medium"
                android:text="Dismiss Alert"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:backgroundTint="#0F172A"
                app:strokeColor="#334155"
                app:strokeWidth="1dp"
                android:visibility="gone"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
