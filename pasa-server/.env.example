# PASA Control Plane & Telegram Gateway Configuration

# Port to listen on (default: 8160)
PORT=8160

# Master Admin Access Key for https://<your-domain>/pasa/admin and /api/admin/*
# If not specified, a secure random key will be generated in data/admin_secret.json on first boot.
ADMIN_SECRET=your_secure_admin_key_here

# Default Telegram Bot Token (optional: individual devices can supply their own during registration)
# BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Cross-origin browser access to the API (admin console / landing page).
# Comma-separated origins, e.g. https://pasa.izhaanintellect.fun
# Leave empty to disallow all cross-origin browser requests (default; the
# Android agent is unaffected since it sends no Origin header).
ALLOWED_ORIGIN=

# Commercial licensing endpoints (/api/license/purchase, /api/webhook/payment,
# /api/license/lookup) are DISABLED by default. Set to true only if you run
# PASA as a paid product. For personal use, leave this off.
ENABLE_LICENSING=false

# Designated Administrator Telegram Chat ID (receives order verification alerts)
ADMIN_CHAT_ID=5497803807

# Optional dedicated Telegram bot token for admin order notifications
# ADMIN_BOT_TOKEN=

# Cryptographic secret for verifying payment webhook HMAC signatures
# PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here

# Binance Pay merchant credentials for license purchases
BINANCE_PAY_ID=756303714
BINANCE_NICKNAME=RBR48
