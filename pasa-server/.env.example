# =============================================================================
#  PASA Sentinel Control Plane — Environment Configuration Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git. This .env.example is safe to commit.
# =============================================================================

# ── Telegram Bot Tokens ───────────────────────────────────────────────────────
# Primary C2 bot token (from @BotFather). KEEP SECRET.
# If you believe this token is compromised, revoke it in @BotFather immediately.
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Support/customer-facing bot token (separate from C2 bot)
PASA_CENTRAL_BOT_TOKEN=YOUR_SUPPORT_BOT_TOKEN_HERE

# Admin bot (can be same as BOT_TOKEN if using one bot)
ADMIN_BOT_TOKEN=YOUR_ADMIN_BOT_TOKEN_HERE

# ── Access Control ────────────────────────────────────────────────────────────
# Your personal Telegram numeric user ID.
# Only this chat_id can issue device commands. Get yours by messaging @userinfobot.
# CRITICAL: Without this, anyone who finds your bot token can control your devices.
ADMIN_CHAT_ID=YOUR_TELEGRAM_USER_ID_HERE

# Admin API key for the /api/admin/* endpoints.
# Must be at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=REPLACE_WITH_64_HEX_CHARS_MINIMUM_32_RANDOM_BYTES

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8160

# Allowed browser origin for CORS (your web dashboard URL).
# Leave empty to block all cross-origin browser requests.
ALLOWED_ORIGIN=https://pasa.izhaanintellect.fun

# ── Licensing ─────────────────────────────────────────────────────────────────
ENABLE_LICENSING=true
BINANCE_PAY_ID=756303714
BINANCE_NICKNAME=RBR48

# ── Security Notes ────────────────────────────────────────────────────────────
# 1. Rotate BOT_TOKEN in @BotFather if ever exposed publicly.
# 2. Set ADMIN_CHAT_ID — this is the single most important access control.
# 3. Generate ADMIN_KEY with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. Never share .env in chat, email, or version control.
# 5. Store pasa-release-key.jks on an air-gapped drive, not this server.
